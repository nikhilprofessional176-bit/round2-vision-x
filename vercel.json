{
  "version": 2,
  "name": "smart-classroom-platform",
  "builds": [
    {
      "src": "server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/server.js"
    },
    {
      "src": "/teacher",
      "dest": "/teacher.html"
    },
    {
      "src": "/analytics",
      "dest": "/teacher-analysis.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
